generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  NONE
  BASIC
  VERIFIED
}

enum Profession {
  STUDENT
  IT_PROFESSIONAL
  JOB_SEEKER
  FREELANCER
  BUSINESS_OWNER
  OTHER
}

enum MoveTimeframe {
  MONTHS_0_3
  MONTHS_3_12
  YEAR_1_PLUS
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_SAY
}

enum ProfileVisibility {
  PUBLIC
  COMMUNITY_ONLY
  PRIVATE
}

enum CommunityType {
  INTERSTATE
  GLOBAL
  STATE_CIRCLE
  DISTRICT_CIRCLE
}

enum CircleLevel {
  STATE
  DISTRICT
  MOHALLA
}

enum PostType {
  QUESTION
  HELP
  RESOURCE
  GENERAL
}

enum CommunityPostType {
  GENERAL
  JOB_SHARE
  EVENT_SHARE
  SOS
  MEETUP
  GYAAN
  WELCOME
}

enum SOSCategory {
  HOUSING
  PAYMENT
  MEDICAL
  SAFETY
  LOAN
  LEGAL
  OTHER
}

enum SOSStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum MemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum MemberStatus {
  PENDING
  APPROVED
  BANNED
}

enum ReactionType {
  UPVOTE
  DOWNVOTE
  LIKE
  LOVE
  LAUGH
  WOW
}

enum ReportTargetType {
  POST
  COMMENT
  COMMUNITY
  USER
}

enum RSVPStatus {
  YES
  NO
}

enum UserPlatformRole {
  JOB_SEEKER
  SERVICE_PROVIDER
  EVENT_ORGANIZER
  COMMUNITY_MEMBER
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  HIRED
  REJECTED
}

enum JobPostStatus {
  OPEN
  FILLED
  CLOSED
}

enum ServiceCategory {
  PLUMBER
  DOCTOR
  TUTOR
  LAWYER
  DRIVER
  ELECTRICIAN
  CARPENTER
  PAINTER
  COOK
  CLEANER
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String?
  name      String?
  image     String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  reports             Report[]
  reportedIn          Report[]           @relation("UserReports")
  memberships         CommunityMember[]
  eventsCreated       Event[]
  rsvps               EventRSVP[]
  following           Follow[]           @relation("Following")
  followers           Follow[]           @relation("Followers")
  vouchesGiven        TrustVouch[]       @relation("Voucher")
  vouchesReceived     TrustVouch[]       @relation("Vouchee")
  jobPosts            JobPost[]
  applications        Application[]
  serviceProvider     ServiceProvider?
  serviceBookings     ServiceBooking[]   @relation("ServiceCustomer")
  serviceReviews      ServiceReview[]    @relation("ServiceReviewer")
  circleMemberships   CircleMembership[]
  circleModerators    CircleModerator[]
  communityPosts      CommunityPost[]
  postReplies         PostReply[]
  postLikes           PostLike[]
  sosRequests         SOSRequest[]
  sosResponses        SOSResponse[]
  meetups             Meetup[]
  meetupRsvps         MeetupRsvp[]
  gyaanEntries        GyaanEntry[]
  gyaanUpvotes        GyaanUpvote[]
  parichayRequests    Parichay[]         @relation("ParichayRequester")
  parichayConnections Parichay[]         @relation("ParichayConnector")
  parichayTargets     Parichay[]         @relation("ParichayTarget")
  leaderboardEntries  LeaderboardEntry[]
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio              String?
  phone            String?
  nativePlace      String?
  nativePlaceCity  String?
  nativePlaceState String?
  currentLocality  String?
  gender           Gender?
  dateOfBirth      DateTime?
  originCountry    String?
  originState      String?
  originCity       String?
  currentCountry   String?
  currentState     String?
  currentCity      String?

  interests       String[]       @default([])
  languages       String[]       @default([])
  languagesSpoken String[]       @default([])
  communities     String[]       @default([])
  needs           String[]       @default([])
  canOffer        String[]       @default([])
  profession      Profession?
  movedToCityWhen MoveTimeframe?

  verificationLevel VerificationLevel  @default(NONE)
  trustScore        Int                @default(0)
  platformRoles     UserPlatformRole[] @default([])
  aadhaarVerified   Boolean            @default(false)

  showEmail           Boolean           @default(false)
  showPhone           Boolean           @default(false)
  showApproxLocation  Boolean           @default(true)
  profileVisibility   ProfileVisibility @default(PUBLIC)
  showNativePlace     Boolean           @default(true)
  showActivity        Boolean           @default(true)
  allowFollow         Boolean           @default(true)
  onboardingCompleted Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Follow {
  id              String   @id @default(cuid())
  followerUserId  String
  followingUserId String
  createdAt       DateTime @default(now())

  follower  User @relation("Following", fields: [followerUserId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingUserId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, followingUserId])
  @@index([followingUserId])
  @@index([followerUserId])
}

model Community {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  type               CommunityType
  originCountry      String?
  originState        String?
  originCity         String?
  destinationCountry String?
  destinationState   String?
  destinationCity    String?

  description String?
  rules       String?
  banner      String?
  avatar      String?
  visibility  CommunityVisibility @default(PUBLIC)
  memberCount Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CommunityMember[]
  posts   Post[]
  events  Event[]
  reports Report[]          @relation("CommunityReports")

  @@index([type, visibility])
  @@index([originCountry, originState, originCity])
  @@index([destinationCountry, destinationState, destinationCity])
}

model CommunityMember {
  id          String       @id @default(cuid())
  userId      String
  communityId String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(APPROVED)
  joinedAt    DateTime     @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, role, status])
}

model Post {
  id              String   @id @default(cuid())
  communityId     String?
  authorId        String
  type            PostType
  title           String
  body            String
  tags            String[] @default([])
  locationContext String?
  imageUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]
  reports   Report[]   @relation("PostReports")

  @@index([communityId, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  depth     Int      @default(0)
  createdAt DateTime @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentToParent", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentToParent")

  reports Report[] @relation("CommentReports")

  @@index([postId, createdAt])
}

model Reaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  reason     String
  reporterId String
  createdAt  DateTime         @default(now())

  reporter     User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post         Post?      @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?   @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)
  community    Community? @relation("CommunityReports", fields: [communityId], references: [id], onDelete: Cascade)
  reportedUser User?      @relation("UserReports", fields: [reportedUserId], references: [id], onDelete: Cascade)

  postId         String?
  commentId      String?
  communityId    String?
  reportedUserId String?

  @@index([targetType, targetId])
}

model Event {
  id            String   @id @default(cuid())
  communityId   String
  creatorId     String
  title         String
  description   String?
  startsAt      DateTime
  location      String?
  onlineLink    String?
  capacity      Int?
  coverImageUrl String?
  createdAt     DateTime @default(now())

  community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator   User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps     EventRSVP[]
  posts     CommunityPost[]  // Posts that share this event

  @@index([communityId, startsAt])
}

model EventRSVP {
  id      String     @id @default(cuid())
  eventId String
  userId  String
  status  RSVPStatus

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TrustVouch {
  id        String   @id @default(cuid())
  voucherId String
  voucheeId String
  note      String?
  createdAt DateTime @default(now())

  voucher User @relation("Voucher", fields: [voucherId], references: [id], onDelete: Cascade)
  vouchee User @relation("Vouchee", fields: [voucheeId], references: [id], onDelete: Cascade)

  @@unique([voucherId, voucheeId])
  @@index([voucheeId])
}

model JobPost {
  id               String        @id @default(cuid())
  employerId       String
  title            String
  skillCategory    String
  payMin           Int?
  payMax           Int?
  location         String
  languagePref     String[]
  statePref        String?
  numberOfOpenings Int           @default(1)
  deadline         DateTime?
  status           JobPostStatus @default(OPEN)
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  employer     User            @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications Application[]
  posts        CommunityPost[] // Posts that share this job

  @@index([employerId, status])
  @@index([status, createdAt])
  @@index([statePref])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  seekerId  String
  status    ApplicationStatus @default(APPLIED)
  message   String?
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job    JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker User    @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerId])
  @@index([seekerId, status])
  @@index([jobId, status])
}

model ServiceProvider {
  id          String          @id @default(cuid())
  userId      String          @unique
  category    ServiceCategory
  languages   String[]
  serviceArea String[]
  rate        String?
  ratingAvg   Float           @default(0)
  reviewCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews  ServiceReview[]
  bookings ServiceBooking[]

  @@index([category, ratingAvg])
  @@index([userId])
}

model ServiceBooking {
  id          String    @id @default(cuid())
  providerId  String
  customerId  String
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer User            @relation("ServiceCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([customerId])
}

model ServiceReview {
  id         String   @id @default(cuid())
  providerId String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer User            @relation("ServiceReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([providerId, reviewerId])
  @@index([providerId])
}

model Circle {
  id             String      @id @default(cuid())
  name           String
  level          CircleLevel
  state          String
  district       String?
  mohalla        String?
  city           String
  memberCount    Int         @default(0)
  isAutoFormed   Boolean     @default(true)
  formThreshold  Int         @default(10)
  isActive       Boolean     @default(false)
  healthScore    Int         @default(0)
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())

  memberships  CircleMembership[]
  posts        CommunityPost[]
  moderators   CircleModerator[]
  leaderboard  LeaderboardEntry[]
  gyaanEntries GyaanEntry[]
  meetups      Meetup[]

  @@index([city, state])
  @@index([city, level])
}

model CircleMembership {
  id                 String   @id @default(cuid())
  circle             Circle   @relation(fields: [circleId], references: [id])
  circleId           String
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  isWelcomeCommittee Boolean  @default(false)
  joinedAt           DateTime @default(now())
  lastActiveAt       DateTime @default(now())
  postCount          Int      @default(0)
  helpCount          Int      @default(0)
  introCount         Int      @default(0)

  @@unique([circleId, userId])
  @@index([circleId])
}

model CircleModerator {
  id         String   @id @default(cuid())
  circle     Circle   @relation(fields: [circleId], references: [id])
  circleId   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  electedAt  DateTime @default(now())
  termEndsAt DateTime
  voteCount  Int      @default(0)
  isActive   Boolean  @default(true)

  @@unique([circleId, userId])
}

model CommunityPost {
  id         String            @id @default(cuid())
  circle     Circle            @relation(fields: [circleId], references: [id])
  circleId   String
  author     User              @relation(fields: [authorId], references: [id])
  authorId   String
  type       CommunityPostType @default(GENERAL)
  content    String
  mediaUrls  String[]
  isPinned   Boolean           @default(false)
  isSOS      Boolean           @default(false)
  likeCount  Int               @default(0)
  replyCount Int               @default(0)
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
  jobPostId  String?           // Link to JobPost if this is a job share
  eventId    String?           // Link to Event if this is an event share

  sos        SOSRequest?
  meetup     Meetup?
  gyaanEntry GyaanEntry?
  replies    PostReply[]
  likes      PostLike[]
  jobPost    JobPost?          @relation(fields: [jobPostId], references: [id])
  event      Event?            @relation(fields: [eventId], references: [id])

  @@index([circleId, createdAt])
  @@index([circleId, isSOS])
}

model PostReply {
  id        String        @id @default(cuid())
  post      CommunityPost @relation(fields: [postId], references: [id])
  postId    String
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime      @default(now())

  @@index([postId])
}

model PostLike {
  id        String        @id @default(cuid())
  post      CommunityPost @relation(fields: [postId], references: [id])
  postId    String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model SOSRequest {
  id          String        @id @default(cuid())
  post        CommunityPost @relation(fields: [postId], references: [id])
  postId      String        @unique
  requester   User          @relation(fields: [requesterId], references: [id])
  requesterId String
  category    SOSCategory
  urgency     Int           @default(3)
  status      SOSStatus     @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime      @default(now())

  responses SOSResponse[]

  @@index([status])
}

model SOSResponse {
  id            String     @id @default(cuid())
  sos           SOSRequest @relation(fields: [sosId], references: [id])
  sosId         String
  responder     User       @relation(fields: [responderId], references: [id])
  responderId   String
  message       String
  contactShared Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([sosId])
}

model Meetup {
  id          String        @id @default(cuid())
  circle      Circle        @relation(fields: [circleId], references: [id])
  circleId    String
  post        CommunityPost @relation(fields: [postId], references: [id])
  postId      String        @unique
  organizer   User          @relation(fields: [organizerId], references: [id])
  organizerId String
  title       String
  location    String
  meetupDate  DateTime
  rsvpCount   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  eventId     String?       // Link to Event if this meetup is from an event

  rsvps MeetupRsvp[]

  @@index([circleId, meetupDate])
}

model MeetupRsvp {
  id        String   @id @default(cuid())
  meetup    Meetup   @relation(fields: [meetupId], references: [id])
  meetupId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([meetupId, userId])
}

model GyaanEntry {
  id          String        @id @default(cuid())
  circle      Circle        @relation(fields: [circleId], references: [id])
  circleId    String
  post        CommunityPost @relation(fields: [postId], references: [id])
  postId      String        @unique
  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
  title       String
  category    String
  upvoteCount Int           @default(0)
  isPinned    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  upvotes GyaanUpvote[]

  @@index([circleId, category])
}

model GyaanUpvote {
  id        String     @id @default(cuid())
  entry     GyaanEntry @relation(fields: [entryId], references: [id])
  entryId   String
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime   @default(now())

  @@unique([entryId, userId])
}

model Parichay {
  id          String   @id @default(cuid())
  requester   User     @relation("ParichayRequester", fields: [requesterId], references: [id])
  requesterId String
  connector   User     @relation("ParichayConnector", fields: [connectorId], references: [id])
  connectorId String
  target      User     @relation("ParichayTarget", fields: [targetId], references: [id])
  targetId    String
  note        String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  circle    Circle   @relation(fields: [circleId], references: [id])
  circleId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  month     String
  category  String
  rank      Int
  score     Int
  createdAt DateTime @default(now())

  @@unique([circleId, userId, month, category])
  @@index([circleId, month])
}
